# 安装 Skill / 克隆仓库后，把本文件复制到本机（仅当目标尚不存在）：
#   mkdir -p ~/.marketreview
#   [ -e ~/.marketreview/config ] || cp <skill-dir>/config/marketreview.config.example ~/.marketreview/config
#   [ -e ~/.marketreview/supabase.secret ] || cp <skill-dir>/config/supabase.secret.example ~/.marketreview/supabase.secret
#   chmod 600 ~/.marketreview/supabase.secret
# 已有 config 或 supabase.secret 时不要覆盖，对照本模板手工补字段。
# 再按控制台 Project Settings → API Keys 自行填写。
# 完整说明见 README「云端配置模板」与 SKILL.md「云端配置」。
# 不要把填好的文件提交进 Git、打进发布包，或贴到日志 / Issue。

# backend 只能是 sqlite 或 supabase。
# 未写这一行时，进程默认是 supabase。模板写明 supabase，避免复制后把默认盖回 sqlite。
# 本地后端用 --backend sqlite 选择；该参数不限制写入。只读查询须用 get。
# 若要长期使用本地模式，可设置 backend=sqlite；迁移到云端后改回 supabase。
backend=supabase

# 项目 URL（控制台 Project URL），不含密钥。
supabase_url=https://PROJECT_REF.supabase.co

# Publishable key（sb_publishable_...；旧名 anon 亦可）。
# 低权限，可写在本文件；日常写 RPC 仍用 Secret，本字段供鉴权拒绝实测等使用。
supabase_publishable_key=sb_publishable_REPLACE_ME

# Secret Key 不要写在这个文件里。
# 另建 ~/.marketreview/supabase.secret：单行 sb_secret_...（或旧名 service_role），权限 600。
# 可参考同目录 supabase.secret.example。
# 兼容：仅当 supabase.secret 不存在时，可读 ~/.marketreview/supabase.config 里的 SUPABASE_SECRET_KEY；
# 文件存在但内容无效时直接报错，不回退旧密钥。
